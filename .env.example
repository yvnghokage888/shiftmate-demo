# Supabase project used by the app. Copy this file to .env.local and fill in your own.
#
# Only the publishable "anon" key goes here. It is safe in the browser because
# row-level security enforces access. NEVER put the service_role / secret key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
